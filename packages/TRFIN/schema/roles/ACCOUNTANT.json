{
  "name": "/TRFIN/ACCOUNTANT",
  "texts": {
    "en": {
      "label": "Accountant",
      "description": "Posts, clears, changes the texts of, reverses and reads journal entries, resets clearings, runs and exports the reports and the reconciliation in all companies and ledgers, and reads the configuration, the master data and the partners"
    },
    "de": {
      "label": "Buchhalter",
      "description": "Bucht und gleicht aus, ändert Texte von Belegen, storniert und liest sie, nimmt Ausgleiche zurück, führt Berichte und Abgleich aus und exportiert Berichte in allen Buchungskreisen und Ledgern und liest Konfiguration, Stammdaten und Partner"
    }
  },
