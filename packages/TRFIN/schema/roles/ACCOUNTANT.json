{
  "name": "/TRFIN/ACCOUNTANT",
  "texts": {
    "en": {
      "label": "Accountant",
      "description": "Posts, changes the texts of, reverses and reads journal entries in all companies and ledgers, and reads the configuration, the master data and the partners"
    },
    "de": {
      "label": "Buchhalter",
      "description": "Bucht Belege, ändert ihre Texte, storniert und liest sie in allen Buchungskreisen und Ledgern und liest Konfiguration, Stammdaten und Partner"
    }
  },
