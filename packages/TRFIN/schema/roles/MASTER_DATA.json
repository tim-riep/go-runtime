          {
            "pattern": "/TRFIN/*"
          }
        ],
        "DATA_CLASS": [
          {
            "value": "configuration"
          },
          {
            "value": "runtimeConfiguration"
          }
        ],
        "ACTIVITY": [
          {
            "value": "READ"
          }
        ]
      }
    }
  ]
