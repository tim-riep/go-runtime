    "en": {
      "label": "Display general ledger",
      "description": "Reads the configuration, the master data and the journal entries of the general ledger"
    },
    "de": {
      "label": "Hauptbuch anzeigen",
      "description": "Liest die Konfiguration, die Stammdaten und die Belege des Hauptbuchs"
