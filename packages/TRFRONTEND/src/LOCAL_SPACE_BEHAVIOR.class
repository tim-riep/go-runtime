# The behavior of the local spaces of the start page: local names,
# references that exist and the local copy of a shipped entry.
public class /TRFRONTEND/LOCAL_SPACE_BEHAVIOR

  public method CHECK_SPACE(keys: array of key of /TRFRONTEND/LOCAL_SPACES, response: /TRBASE/ENTITY_RESPONSE)
    for i, key in keys
      if not key.NAME.STARTS_WITH("/LOCAL/")
        response.FIELD_ERROR(i, "NAME", "local entries are named /LOCAL/<NAME>")
      end
      var pages = read business object /TRFRONTEND/LOCAL_SPACE in local mode
        /TRFRONTEND/LOCAL_SPACE_PAGES by parent fields all keys [key]
      end
      for p in pages
        try
          if not /TRFRONTEND/LOCAL_ENTRIES.EXISTS("/TRFRONTEND/PAGE", p.PAGE)
            response.ERROR(i, "the page {p.PAGE} does not exist")
          end
        catch e: /RT/EXCEPTION
          response.ERROR(i, e.TEXT)
        end
      end
    end
  end

  # Copies a shipped space with its pages.
  public method COPY_SPACE(parameter: /TRFRONTEND/COPY_REQUEST, response: /TRBASE/ENTITY_RESPONSE) returns /TRFRONTEND/COPY_RESULT
    try
      /TRFRONTEND/LOCAL_ENTRIES.LOCAL_NAME(parameter.NAME)
      var space = transform /TRFRONTEND/LOCAL_ENTRIES.SHIPPED(parameter.SOURCE, "/TRFRONTEND/SPACE") using /TRBASE/JSON into /TRFRONTEND/SPACE
      var row: new of /TRFRONTEND/LOCAL_SPACES
      row.LINK = "s"
      row.NAME = parameter.NAME
      var texts: array of new of /TRFRONTEND/LOCAL_SPACE_TEXTS = []
      for t in space.TEXTS
        var text: new of /TRFRONTEND/LOCAL_SPACE_TEXTS
        text.PARENT_LINK = "s"
        text.LANGUAGE = t.LANGUAGE
        text.TITLE = t.TITLE
        texts.APPEND(text)
      end
      var pages: array of new of /TRFRONTEND/LOCAL_SPACE_PAGES = []
      for i, p in space.PAGES default []
        var page: new of /TRFRONTEND/LOCAL_SPACE_PAGES
        page.PARENT_LINK = "s"
        page.POSITION = i as INT4
        page.PAGE = p.PAGE
        pages.APPEND(page)
      end
      modify business object /TRFRONTEND/LOCAL_SPACE in local mode
        create /TRFRONTEND/LOCAL_SPACES fields (NAME) from [row]
        create /TRFRONTEND/LOCAL_SPACE_TEXTS by parent fields (LANGUAGE, TITLE) from texts
        create /TRFRONTEND/LOCAL_SPACE_PAGES by parent fields (POSITION, PAGE) from pages
      end
    catch e: /RT/EXCEPTION
      # Static actions cannot fail; nothing is created, and the message
      # tells why.
      response.GLOBAL_MESSAGE(/TRBASE/MESSAGE_SEVERITY.ERROR, e.TEXT)
    end
    var result: /TRFRONTEND/COPY_RESULT
    result.NAME = parameter.NAME
    return result
  end

end
