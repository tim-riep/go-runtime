# The behavior of the local apps of the start page: local names,
# references that exist and the local copy of a shipped entry.
public class /TRFRONTEND/LOCAL_APP_BEHAVIOR

  public method CHECK_APP(keys: array of key of /TRFRONTEND/LOCAL_APPS, response: /TRBASE/ENTITY_RESPONSE)
    for i, key in keys
      if not key.NAME.STARTS_WITH("/LOCAL/")
        response.FIELD_ERROR(i, "NAME", "local entries are named /LOCAL/<NAME>")
      end
    end
  end

  # Copies a shipped app with its texts and parameters.
  public method COPY_APP(parameter: /TRFRONTEND/COPY_REQUEST, response: /TRBASE/ENTITY_RESPONSE) returns /TRFRONTEND/COPY_RESULT
    try
      /TRFRONTEND/LOCAL_ENTRIES.LOCAL_NAME(parameter.NAME)
      var app = transform /TRFRONTEND/LOCAL_ENTRIES.SHIPPED(parameter.SOURCE, "/TRFRONTEND/APP") using /TRBASE/JSON into /TRFRONTEND/APP
      var row: new of /TRFRONTEND/LOCAL_APPS
      row.LINK = "app"
      row.NAME = parameter.NAME
      row.ICON = app.ICON
      row.TARGET_KIND = app.TARGET.KIND
      row.SERVICE = app.TARGET.SERVICE
      row.ENTITY_SET = app.TARGET.ENTITY_SET
      row.NODE = app.TARGET.NODE
      row.PATH = app.TARGET.PATH
      row.MODULE = app.TARGET.MODULE
      row.URL = app.TARGET.URL
      var texts: array of new of /TRFRONTEND/LOCAL_APP_TEXTS = []
      for t in app.TEXTS
        var text: new of /TRFRONTEND/LOCAL_APP_TEXTS
        text.PARENT_LINK = "app"
        text.LANGUAGE = t.LANGUAGE
        text.TITLE = t.TITLE
        text.SUBTITLE = t.SUBTITLE
        texts.APPEND(text)
      end
      var params: array of new of /TRFRONTEND/LOCAL_APP_PARAMETERS = []
      for p in app.PARAMETERS default []
        var par: new of /TRFRONTEND/LOCAL_APP_PARAMETERS
        par.PARENT_LINK = "app"
        par.PARAMETER = p.NAME
        par.VALUE = p.VALUE
        params.APPEND(par)
      end
      modify business object /TRFRONTEND/LOCAL_APP in local mode
        create /TRFRONTEND/LOCAL_APPS fields (NAME, ICON, TARGET_KIND, SERVICE, ENTITY_SET, NODE, PATH, MODULE, URL) from [row]
        create /TRFRONTEND/LOCAL_APP_TEXTS by parent fields (LANGUAGE, TITLE, SUBTITLE) from texts
        create /TRFRONTEND/LOCAL_APP_PARAMETERS by parent fields (PARAMETER, VALUE) from params
      end
    catch e: /RT/EXCEPTION
      # Static actions cannot fail; nothing is created, and the message
      # tells why.
      response.GLOBAL_MESSAGE(/TRBASE/MESSAGE_SEVERITY.ERROR, e.TEXT)
    end
    var result: /TRFRONTEND/COPY_RESULT
    result.NAME = parameter.NAME
    return result
  end

end
