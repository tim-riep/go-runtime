# The behavior of the local tiles of the start page: local names,
# references that exist and the local copy of a shipped entry.
public class /TRFRONTEND/LOCAL_TILE_BEHAVIOR

  public method CHECK_TILE(keys: array of key of /TRFRONTEND/LOCAL_TILES, response: /TRBASE/ENTITY_RESPONSE)
    var tiles = read business object /TRFRONTEND/LOCAL_TILE in local mode
      /TRFRONTEND/LOCAL_TILES fields all keys keys
    end
    for i, tile in tiles
      if not tile.NAME.STARTS_WITH("/LOCAL/")
        response.FIELD_ERROR(i, "NAME", "local entries are named /LOCAL/<NAME>")
      end
      try
        if not /TRFRONTEND/LOCAL_ENTRIES.EXISTS("/TRFRONTEND/APP", tile.APP)
          response.FIELD_ERROR(i, "APP", "the app {tile.APP} does not exist")
        end
      catch e: /RT/EXCEPTION
        response.FIELD_ERROR(i, "APP", e.TEXT)
      end
      if tile.SIZE = /TRFRONTEND/TILE_SIZE.LARGE and tile.KIND <> /TRFRONTEND/TILE_KIND.CONTENT
        response.FIELD_ERROR(i, "SIZE", "only content tiles are LARGE")
      end
      if tile.KIND = /TRFRONTEND/TILE_KIND.METRIC and (tile.METRIC_SERVICE is null or tile.METRIC_ENTITY_SET is null)
        response.FIELD_ERROR(i, "METRIC_SERVICE", "a metric tile needs a service and an entity set")
      end
    end
  end

  # Copies a shipped tile with its texts.
  public method COPY_TILE(parameter: /TRFRONTEND/COPY_REQUEST, response: /TRBASE/ENTITY_RESPONSE) returns /TRFRONTEND/COPY_RESULT
    try
      /TRFRONTEND/LOCAL_ENTRIES.LOCAL_NAME(parameter.NAME)
      var tile = transform /TRFRONTEND/LOCAL_ENTRIES.SHIPPED(parameter.SOURCE, "/TRFRONTEND/TILE") using /TRBASE/JSON into /TRFRONTEND/TILE
      var row: new of /TRFRONTEND/LOCAL_TILES
      row.LINK = "tile"
      row.NAME = parameter.NAME
      row.APP = tile.APP
      row.KIND = tile.KIND
      row.SIZE = tile.SIZE
      var metric = tile.METRIC
      if metric is not null
        row.METRIC_SERVICE = metric.SERVICE
        row.METRIC_ENTITY_SET = metric.ENTITY_SET
        row.METRIC_FILTER = metric.FILTER
        row.METRIC_TONE = metric.TONE
      end
      var texts: array of new of /TRFRONTEND/LOCAL_TILE_TEXTS = []
      for t in tile.TEXTS default []
        var text: new of /TRFRONTEND/LOCAL_TILE_TEXTS
        text.PARENT_LINK = "tile"
        text.LANGUAGE = t.LANGUAGE
        text.TITLE = t.TITLE
        text.SUBTITLE = t.SUBTITLE
        text.FOOTER = t.FOOTER
        text.UNIT = t.UNIT
        text.CONTENT = t.CONTENT
        texts.APPEND(text)
      end
      modify business object /TRFRONTEND/LOCAL_TILE in local mode
        create /TRFRONTEND/LOCAL_TILES fields (NAME, APP, KIND, SIZE, METRIC_SERVICE, METRIC_ENTITY_SET, METRIC_FILTER, METRIC_TONE) from [row]
        create /TRFRONTEND/LOCAL_TILE_TEXTS by parent fields (LANGUAGE, TITLE, SUBTITLE, FOOTER, UNIT, CONTENT) from texts
      end
    catch e: /RT/EXCEPTION
      # Static actions cannot fail; nothing is created, and the message
      # tells why.
      response.GLOBAL_MESSAGE(/TRBASE/MESSAGE_SEVERITY.ERROR, e.TEXT)
    end
    var result: /TRFRONTEND/COPY_RESULT
    result.NAME = parameter.NAME
    return result
  end

end
