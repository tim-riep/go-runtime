    },
    {
      "name": "METHOD_NAME",
      "domain": "/RT/OBJECT_NAME"
    },
    {
      "name": "LINE_NO",
      "domain": "/RT/POSITION"
    },
    {
      "name": "KERNEL_FUNCTION",
      "domain": "/RT/KERNEL_FUNCTION"
    },
    {
      "name": "CONDITION_SQL",
      "domain": "/RT/CHECK_DATA",
      "description": "Condition of a filter"
    },
    {
      "name": "ROW_COUNT",
      "domain": "/RT/GENERATION",
      "description": "Rows that a filtered statement read or changed"
    }
