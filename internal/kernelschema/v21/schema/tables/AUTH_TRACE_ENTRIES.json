{
  "name": "/RT/AUTH_TRACE_ENTRIES",
  "description": "Authorization checks recorded by a trace",
  "tenantSpecific": false,
  "dataClass": "system",
  "fields": [
    {
      "name": "ENTRY_ID",
      "domain": "/RT/LOG_ID"
    },
    {
      "name": "CHECKED_AT",
      "domain": "/RT/TIMESTAMP",
      "notNull": true
    },
    {
      "name": "USER_NAME",
      "domain": "/RT/USER_NAME",
      "notNull": true
    },
    {
      "name": "TENANT",
      "domain": "/RT/TENANT_ID"
    },
    {
      "name": "CHECK_MODE",
      "domain": "/RT/CHECK_MODE",
      "notNull": true
    },
    {
      "name": "OBJECT_NAME",
      "domain": "/RT/OBJECT_NAME",
      "notNull": true
    },
    {
      "name": "ALLOWED",
