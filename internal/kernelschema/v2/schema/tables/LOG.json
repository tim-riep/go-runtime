{
  "name": "/RT/LOG",
  "description": "Log of installations, upgrades, removals, migrations and tenant deletions",
  "tenantSpecific": false,
  "dataClass": "system",
  "fields": [
    {
      "name": "LOG_ID",
      "domain": "/RT/LOG_ID"
    },
    {
      "name": "OPERATION",
      "domain": "/RT/OPERATION",
      "notNull": true
    },
    {
      "name": "TARGET",
      "domain": "/RT/OBJECT_NAME",
      "description": "Affected object other than packages, e.g. the deleted tenant"
    },
    {
      "name": "STARTED_AT",
      "domain": "/RT/TIMESTAMP",
      "notNull": true
    },
    {
      "name": "FINISHED_AT",
      "domain": "/RT/TIMESTAMP",
      "notNull": true
    },
    {
      "name": "STATUS",
      "domain": "/RT/LOG_STATUS",
      "notNull": true
    },
    {
      "name": "MESSAGE",
      "domain": "/RT/DESCRIPTION"
    }
  ],
  "primaryKey": [
    "LOG_ID"
  ]
}
