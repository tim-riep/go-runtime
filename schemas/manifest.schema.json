{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-riep/go-runtime/schemas/manifest.schema.json",
  "title": "Package manifest",
  "description": "Identity, version and requirements of a package (manifest.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/packageId"
    },
    "version": {
      "description": "Semantic version of the package.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "requires": {
      "description": "Packages this package needs.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/packageId"
          },
          "version": {
            "description": "Version constraint, e.g. \">=1.0.0\", \"^1.2.0\" or \">=1.0.0, <2.0.0\". Omitted means any version.",
            "type": "string"
          }
        }
      }
    }
  }
}
