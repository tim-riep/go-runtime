{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-riep/go-runtime/schemas/domain.schema.json",
  "title": "Domain",
  "description": "A technical type: base type, length, decimals and optional fixed values (schema/domains/<name without namespace>.json).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type"
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/objectName"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "type": {
      "description": "Base type.",
      "enum": [
        "CHAR",
        "STRING",
        "INT4",
        "INT8",
        "DEC",
        "DATE",
        "TIMESTAMP",
        "BOOL",
        "UUID",
        "BLOB"
      ]
    },
    "length": {
      "description": "CHAR: maximum number of characters. DEC: total number of digits (precision).",
      "type": "integer",
      "minimum": 1
    },
    "decimals": {
      "description": "DEC: number of digits after the decimal point (scale).",
      "type": "integer",
      "minimum": 0
    },
    "values": {
      "description": "Fixed values. Only CHAR, INT4 and INT8 domains may have them. The empty string is a valid fixed value; null never is.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": {
            "$ref": "common.schema.json#/$defs/description"
          },
          "name": {
            "description": "Name of the value in code, e.g. HIGH for /PKG/RATING.HIGH. Without it, the value itself is the name if it consists of upper-case letters, digits and underscores and starts with a letter.",
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "maxLength": 63
          }
        }
      }
    },
    "allowEmpty": {
      "description": "Whether fields of the domain accept the empty string. Only for CHAR and STRING; default true. With false the kernel adds a check that rejects \"\".",
      "type": "boolean"
    },
    "default": {
      "description": "Default of fields of the domain that declare no default of their own. A missing default, null and \"\" are three different cases.",
      "type": [
        "string",
        "integer",
        "boolean",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "CHAR",
              "DEC"
            ]
          }
        }
      },
      "then": {
        "required": [
          "length"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "length"
              ]
            },
            {
              "required": [
                "decimals"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CHAR"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "decimals"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "enum": [
                "CHAR",
                "STRING"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "allowEmpty"
          ]
        }
      }
    }
  ]
}
