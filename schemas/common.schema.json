{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-riep/go-runtime/schemas/common.schema.json",
  "title": "Shared definitions",
  "description": "Definitions shared by the package file schemas.",
  "$defs": {
    "packageId": {
      "description": "Package ID: upper-case letters and digits, starting with a letter.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$",
      "maxLength": 16
    },
    "localName": {
      "description": "Name of a field or foreign key of a table, without namespace.",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 63
    },
    "description": {
      "description": "Human-readable description.",
      "type": "string"
    },
    "field": {
      "description": "A field of a table or an extension.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/localName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "domain": {
          "$ref": "#/$defs/objectName",
          "description": "Domain of the field. Use either domain or dataElement."
        },
        "notNull": {
          "description": "Whether the field rejects NULL. Primary key fields are always NOT NULL.",
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "Default value. A missing default, null and \"\" are three different cases: no default, the explicit default null, and the empty string. Strings for CHAR, STRING, DATE, TIMESTAMP, UUID and DEC; integers for INT4 and INT8; booleans for BOOL.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "dataElement": {
          "$ref": "#/$defs/objectName",
          "description": "Data element of the field; its domain gives the type. Use either domain or dataElement."
        }
      },
      "oneOf": [
        {
          "required": [
            "domain"
          ]
        },
        {
          "required": [
            "dataElement"
          ]
        }
      ]
    },
    "foreignKey": {
      "description": "A foreign key referencing the complete primary key of a target table.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "table",
        "fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/localName"
        },
        "table": {
          "$ref": "#/$defs/objectName"
        },
        "fields": {
          "description": "Mapping of local fields to key fields of the target table. The tenant field is added automatically.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "references"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/localName"
              },
              "references": {
                "$ref": "#/$defs/localName"
              }
            }
          }
        }
      }
    },
    "language": {
      "description": "ISO 639-1 language code in lower case.",
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "operations": {
      "description": "Operations allowed on the rows of a table in a setting.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "update",
        "delete"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      }
    },
    "settingTable": {
      "description": "A dependent table of a setting: it references its parent table in the setting through one of its foreign keys.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "parent",
        "foreignKey",
        "operations"
      ],
      "properties": {
        "table": {
          "$ref": "#/$defs/objectName"
        },
        "parent": {
          "$ref": "#/$defs/objectName",
          "description": "Parent table in the setting."
        },
        "foreignKey": {
          "description": "Name of the foreign key of the table to the parent table; extension keys carry their namespace.",
          "type": "string",
          "pattern": "^(/[A-Z][A-Z0-9]*/)?[A-Z][A-Z0-9_]*$",
          "maxLength": 63
        },
        "operations": {
          "$ref": "#/$defs/operations"
        }
      }
    },
    "objectName": {
      "description": "Name of an object of a package, starting with the namespace of the package, e.g. /TRFIN/COMPANIES. The kernel checks the namespace when it imports the package.",
      "type": "string",
      "pattern": "^(/[A-Z][A-Z0-9]*/)?[A-Z][A-Z0-9_]*$",
      "maxLength": 63
    },
    "extensionField": {
      "description": "A field added by an extension. Its name carries the namespace of the extending package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "domain": {
          "$ref": "#/$defs/objectName",
          "description": "Domain of the field. Use either domain or dataElement."
        },
        "notNull": {
          "description": "Whether the field rejects NULL. Primary key fields are always NOT NULL.",
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "Default value. A missing default, null and \"\" are three different cases: no default, the explicit default null, and the empty string. Strings for CHAR, STRING, DATE, TIMESTAMP, UUID and DEC; integers for INT4 and INT8; booleans for BOOL.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "dataElement": {
          "$ref": "#/$defs/objectName",
          "description": "Data element of the field; its domain gives the type. Use either domain or dataElement."
        }
      },
      "oneOf": [
        {
          "required": [
            "domain"
          ]
        },
        {
          "required": [
            "dataElement"
          ]
        }
      ]
    },
    "extensionForeignKey": {
      "description": "A foreign key added by an extension. Its name and its fields carry the namespace of the extending package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "table",
        "fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "table": {
          "$ref": "#/$defs/objectName"
        },
        "fields": {
          "description": "Mapping of local fields to key fields of the target table. The tenant field is added automatically.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "references"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/objectName"
              },
              "references": {
                "$ref": "#/$defs/localName"
              }
            }
          }
        }
      }
    },
    "include": {
      "description": "Includes a structure or table: its components take the place of this entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "$ref": "#/$defs/objectName"
        }
      }
    },
    "labels": {
      "description": "Label by language code. English (en) is mandatory.",
      "type": "object",
      "required": [
        "en"
      ],
      "propertyNames": {
        "$ref": "#/$defs/language"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "component": {
      "description": "A component of a structure. Its type is exactly one of dataElement, domain, structure (a structure or a table) and arrayType.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/localName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "dataElement": {
          "$ref": "#/$defs/objectName",
          "description": "Data element of the component."
        },
        "domain": {
          "$ref": "#/$defs/objectName",
          "description": "Domain of the component."
        },
        "structure": {
          "$ref": "#/$defs/objectName",
          "description": "Structure or table: a nested component."
        },
        "arrayType": {
          "$ref": "#/$defs/objectName",
          "description": "Array type: an array component."
        },
        "notNull": {
          "description": "Whether the component rejects null; the empty string stays allowed unless the domain forbids it.",
          "type": "boolean"
        },
        "default": {
          "description": "Default value. A missing default, null and \"\" are three different cases: no default, the explicit default null, and the empty string. Strings for CHAR, STRING, DATE, TIMESTAMP, UUID and DEC; integers for INT4 and INT8; booleans for BOOL.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "dataElement"
          ]
        },
        {
          "required": [
            "domain"
          ]
        },
        {
          "required": [
            "structure"
          ]
        },
        {
          "required": [
            "arrayType"
          ]
        }
      ]
    },
    "extensionComponent": {
      "description": "A component added by a structure extension. Its name carries the namespace of the extending package.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "dataElement": {
          "$ref": "#/$defs/objectName",
          "description": "Data element of the component."
        },
        "domain": {
          "$ref": "#/$defs/objectName",
          "description": "Domain of the component."
        },
        "structure": {
          "$ref": "#/$defs/objectName",
          "description": "Structure or table: a nested component."
        },
        "arrayType": {
          "$ref": "#/$defs/objectName",
          "description": "Array type: an array component."
        },
        "notNull": {
          "description": "Whether the component rejects null; the empty string stays allowed unless the domain forbids it.",
          "type": "boolean"
        },
        "default": {
          "description": "Default value. A missing default, null and \"\" are three different cases: no default, the explicit default null, and the empty string. Strings for CHAR, STRING, DATE, TIMESTAMP, UUID and DEC; integers for INT4 and INT8; booleans for BOOL.",
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "dataElement"
          ]
        },
        {
          "required": [
            "domain"
          ]
        },
        {
          "required": [
            "structure"
          ]
        },
        {
          "required": [
            "arrayType"
          ]
        }
      ]
    },
    "valueEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "A value {\"value\": v}, a range {\"from\": a, \"to\": b} with both bounds included, or a pattern {\"pattern\": p}: * for all values or a prefix followed by *. null is never granted.",
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          }
        },
        {
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            },
            "to": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          }
        },
        {
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "from": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "to": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "valueEntries": {
      "description": "Entries of values that combine with or.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/valueEntry"
      }
    },
    "descriptions": {
      "description": "Description by language code. English (en) is mandatory.",
      "type": "object",
      "required": [
        "en"
      ],
      "propertyNames": {
        "$ref": "#/$defs/language"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    }
  }
}
