{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-riep/go-runtime/schemas/structure-extension.schema.json",
  "title": "Structure extension",
  "description": "Additional components for a structure of a required package (schema/structure-extensions/*.json). They take effect wherever the structure is used, including tables that include it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structure",
    "components"
  ],
  "properties": {
    "structure": {
      "$ref": "common.schema.json#/$defs/objectName"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/extensionComponent"
      }
    }
  }
}
