{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tim-riep/go-runtime/schemas/role.schema.json",
  "title": "Role",
  "description": "A role (schema/roles/<name without namespace>.json): authorizations on authorization objects, or as composite role a list of other roles. Local roles have the same format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "texts"
  ],
  "oneOf": [
    {
      "required": [
        "authorizations"
      ]
    },
    {
      "required": [
        "roles"
      ]
    }
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/objectName"
    },
    "texts": {
      "$ref": "common.schema.json#/$defs/labels"
    },
    "authorizations": {
      "description": "The authorizations of a single role. Every field of the object must be given; fields combine with and, the entries of a field with or.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "fields"
        ],
        "properties": {
          "object": {
            "$ref": "common.schema.json#/$defs/objectName"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/valueEntries"
            }
          }
        }
      }
    },
    "roles": {
      "description": "The members of a composite role: single roles only.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/objectName"
      }
    }
  }
}
