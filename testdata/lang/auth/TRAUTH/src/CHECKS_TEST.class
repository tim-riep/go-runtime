public test class /TRAUTH/CHECKS_TEST

  public test method DENIED_WITHOUT_GRANTS()
    try
      /TRAUTH/CHECKS.UPDATE_COMPANY("C1", "DE")
      assert false, "not denied"
    catch e: /RT/NOT_AUTHORIZED
      assert e.OBJECT = "/TRFIN/COMPANY"
    end
  end

  public test method GRANTS()
    /TRBASE/TEST_AUTHORIZATIONS.GRANT("/TRFIN/COMPANY", ["COMPANY_ID=*", "COUNTRY=D*", "COUNTRY=PL..SK", "ACTIVITY=UPDATE"])
    assert /TRAUTH/CHECKS.UPDATE_COMPANY("C1", "DE") = "updated C1"
    assert /TRAUTH/CHECKS.CAN("PT", /RT/ACTIVITY.UPDATE)
    assert not /TRAUTH/CHECKS.CAN("AT", /RT/ACTIVITY.UPDATE)
    /TRBASE/TEST_AUTHORIZATIONS.GRANT_ROLE("/TRFIN/COMPANY_CLERK")
    assert /TRAUTH/CHECKS.CAN("AT", /RT/ACTIVITY.UPDATE)
    /TRBASE/TEST_AUTHORIZATIONS.CLEAR()
    assert not /TRAUTH/CHECKS.CAN("DE", /RT/ACTIVITY.UPDATE)
    /TRBASE/TEST_AUTHORIZATIONS.GRANT_ALL()
    assert /TRAUTH/CHECKS.CAN("FR", /RT/ACTIVITY.DELETE)
  end

  public test method FILTERS()
    /TRAUTH/DOC_ACCESS.ADD(1, "A", 1)
    /TRAUTH/DOC_ACCESS.ADD(2, "B", 2)
    /TRBASE/TEST_AUTHORIZATIONS.GRANT("/TRAUTH/DOC", ["CODE=A", "LEVEL=*", "ACTIVITY=READ"])
    assert /TRAUTH/DOC_ACCESS.VISIBLE() = [1], "only code A"
  end

end
