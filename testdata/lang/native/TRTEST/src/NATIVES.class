# Native methods for the tests of the boundary between the VM and Go.
public class /TRTEST/NATIVES

  public static method ECHO(item: /TRTEST/ITEM) returns /TRTEST/ITEM executed by kernel

  public static method ECHO_ALL(items: /TRTEST/ITEMS) returns /TRTEST/ITEMS executed by kernel

  public static method TEXT(text: STRING?) returns STRING? executed by kernel

  public static method DOUBLE(amount: DEC(15,2)) returns DEC(15,2) executed by kernel

  public static method BAD_CODE() returns /TRTEST/CODE executed by kernel

  public static method FAIL(code: INT4) raises /TRTEST/FAILED executed by kernel

  public static method UNDECLARED() executed by kernel

  public static method BROKEN() returns STRING executed by kernel

  public static method PANIC() executed by kernel

  public static method SLOW() executed by kernel

  public static method SLOW_LIMITED() executed by kernel

  public static method SIZE(data: BYTES) returns INT8 executed by kernel

  public static method TICK() returns TIMESTAMP executed by kernel

  public static method NOTIFY(text: STRING) executed by kernel

  public static method NOTIFY_IN(target: SESSION, text: STRING) executed by kernel

  public static method NOTIFY_COMMIT(text: STRING)
    NOTIFY(text)
    commit
  end

  public static method NOTIFY_ROLLBACK(text: STRING)
    NOTIFY(text)
    rollback
  end

  # The effect waits for the commit of its own session.
  public static method NOTIFY_OTHER(text: STRING)
    var other = open session
    NOTIFY_IN(other, text)
    commit
    NOTIFY(text + " in the default session")
    commit other
  end

  # A wrapper around a method with the capability clock.
  public static method TICK_TWICE() returns array of TIMESTAMP
    return [TICK(), TICK()]
  end

  # A method with a body around a native method.
  public static method FAIL_CODE(code: INT4) returns INT4
    try
      FAIL(code)
    catch e: /TRTEST/FAILED
      return e.CODE
    end
    return 0
  end

end
