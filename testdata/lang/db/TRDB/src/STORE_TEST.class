public test class /TRDB/STORE_TEST

  public test method ADDS_AND_COMMITS()
    /TRDB/STORE.ADD("T1", "test", 1.00)
    commit
    /TRDB/STORE.ADD("T2", "test", 1.00)
    rollback
    assert /TRDB/STORE.COUNT() = 1, "the commit keeps T1, the rollback drops T2"
  end

  public test method STARTS_EMPTY()
    assert /TRDB/STORE.COUNT() = 0, "rows of other tests are gone"
    /TRDB/STORE.ADD("T1", "again", 2.00)
  end

  public test method FAILS()
    /TRDB/STORE.ADD("T3", "test", 1.00)
    assert /TRDB/STORE.COUNT() = 2, "expected to fail"
  end

end
