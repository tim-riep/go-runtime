# Runs XSLT stylesheets that are known only at runtime, e.g. from an asset
# repository or a table. Stylesheets shipped with a package are
# transformations and run with transform.
public class /TRBASE/XSLT_UTILITIES

  public static method RUN(stylesheet: BYTES, input: BYTES) returns BYTES raises /TRBASE/XSLT_FAILED executed by kernel

end
