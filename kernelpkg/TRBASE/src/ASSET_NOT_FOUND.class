# An asset repository has no asset or folder at a path, or the path names
# a folder where an asset is needed, or the other way round.
public class /TRBASE/ASSET_NOT_FOUND extends /TRBASE/ASSET_ERROR

  public attribute PATH: STRING

  public constructor(pkg: STRING, repository: STRING, path: STRING)
    super("asset {path} not found in repository {repository} of package {pkg}", pkg, repository)
    PATH = path
  end

end
