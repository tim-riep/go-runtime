# An asset does not exist, or the calling package may not read it.
public class /TRBASE/ASSET_NOT_FOUND extends /RT/EXCEPTION

  public attribute PACKAGE_ID: STRING
  public attribute REPOSITORY: STRING
  public attribute PATH: STRING

  public constructor(pkg: STRING, repository: STRING, path: STRING)
    super("asset {path} not found in repository {repository} of package {pkg}")
    PACKAGE_ID = pkg
    REPOSITORY = repository
    PATH = path
  end

end
