# Rules for partner IDs on OTTO.
public class /TROTTO/ID_RULES

  public static method BUILD(id: /TRFIN/COMPANY) returns /TROTTO/OTTO_PARTNER
    return "OTTO-" + id
  end

  # The countries with an OTTO marketplace.
  public static method MARKET(country: STRING) returns BOOL
    return country = "DE" or country = "AT"
  end

end
