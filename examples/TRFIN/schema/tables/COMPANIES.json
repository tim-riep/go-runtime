{
  "name": "/TRFIN/COMPANIES",
  "description": "Companies of a tenant",
  "tenantSpecific": true,
  "dataClass": "configuration",
  "fields": [
    {
      "name": "COMPANY_ID",
      "dataElement": "/TRFIN/COMPANY"
    },
    {
      "name": "NAME",
      "dataElement": "/TRBASE/NAME",
      "notNull": true
    },
    {
      "include": "/TRBASE/ADDRESS"
    },
    {
      "name": "STATUS",
      "domain": "/TRFIN/COMPANY_STATUS",
      "notNull": true,
      "default": "ACTIVE"
    },
    {
      "name": "CAPITAL",
      "domain": "/TRBASE/AMOUNT"
    },
    {
      "name": "FOUNDED_ON",
      "domain": "/TRBASE/DATE"
    }
  ],
  "primaryKey": [
    "COMPANY_ID"
  ],
  "foreignKeys": [
    {
      "name": "COUNTRY",
      "table": "/TRFIN/COUNTRIES",
      "fields": [
        {
          "field": "COUNTRY",
          "references": "COUNTRY_CODE"
        }
      ]
    }
  ]
}
