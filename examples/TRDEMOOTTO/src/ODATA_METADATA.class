# Annotates the fields and the action that TRDEMOOTTO adds to the companies of
# TRDEMOFIN in the service /TRDEMOFIN/COMPANY_SERVICE with a vocabulary of its
# own, so that a user interface shows them as data of the marketplace.
public class /TRDEMOOTTO/ODATA_METADATA implements /TRBASE/ODATA_METADATA_EXTENSION

  public method ADJUST(metadata: /TRBASE/ODATA_METADATA) returns /TRBASE/ODATA_METADATA
    var vocabulary: /TRBASE/ODATA_REFERENCE
    vocabulary.URI = "urn:trdemootto:vocabularies:TRDEMOOTTO.Marketplace"
    vocabulary.NAMESPACE = "TRDEMOOTTO.Marketplace"
    vocabulary.ALIAS = "Marketplace"
    metadata.REFERENCES.APPEND(vocabulary)
    var companies = metadata.NAMESPACE + ".TRDEMOFIN_COMPANIES"
    metadata.ANNOTATIONS.APPEND(/TRBASE/ODATA_ANNOTATIONS.TAG(companies + "/TRDEMOOTTO_OTTO_ID", "Marketplace.PartnerId"))
    metadata.ANNOTATIONS.APPEND(/TRBASE/ODATA_ANNOTATIONS.TAG(companies + "/TRDEMOOTTO_PICKUP_POINT", "Marketplace.PickupPoint"))
    var text = "Gives the company a partner ID at OTTO"
    if metadata.LANGUAGE = "de"
      text = "Vergibt der Firma eine Partner-ID bei OTTO"
    end
    metadata.ANNOTATIONS.APPEND(/TRBASE/ODATA_ANNOTATIONS.TEXT(metadata.NAMESPACE + ".TRDEMOOTTO_SYNC", "Core.Description", text))
    return metadata
  end

end
