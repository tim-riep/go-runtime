# Imports orders of the ordering system.
public class /TRDEMOFIN/ORDER_INTAKE

  public static method IMPORT(xml: STRING) returns /TRDEMOFIN/ORDERS raises /TRBASE/XSLT_FAILED
    var order = transform xml using /TRDEMOFIN/ORDER_IMPORT into /TRDEMOFIN/ORDER
    var row: /TRDEMOFIN/ORDERS
    row.ORDER_ID = order.ORDER_ID
    row.COMPANY_ID = order.COMPANY_ID
    row.ORDERED_ON = order.ORDERED_ON
    row.AMOUNT = order.AMOUNT
    row.NOTE = order.NOTE
    insert row
    return row
  end

  public static method FIND(id: STRING) returns /TRDEMOFIN/ORDERS?
    return select single from /TRDEMOFIN/ORDERS where ORDER_ID = id
  end

  # Reads the import format as a company, which does not fit.
  public static method WRONG(xml: STRING) returns STRING
    try
      var company = transform xml using /TRDEMOFIN/ORDER_IMPORT into /TRDEMOFIN/COMPANIES
      return company.NAME
    catch e: /TRBASE/TRANSFORM_RESULT_INVALID
      return e.TEXT
    catch e: /TRBASE/XSLT_FAILED
      return "failed: {e.TEXT}"
    end
  end

end
