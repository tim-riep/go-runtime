# Reads and writes the companies of the tenant of the execution.
public class /TRDEMOFIN/COMPANY_SERVICE

  # Countries are configuration shared by all tenants, maintained through
  # the business object /TRDEMOFIN/COUNTRY with the authorization for
  # configuration of TRBASE.
  public static method ADD_COUNTRY(code: /TRDEMOFIN/COUNTRY_CODE, name: STRING)
    var existing = select count from /TRDEMOFIN/COUNTRIES where COUNTRY_CODE = code
    if existing = 0
      var countries: array of /TRDEMOFIN/COUNTRIES = []
      var country: /TRDEMOFIN/COUNTRIES
      country.COUNTRY_CODE = code
      country.NAME = name
      countries.APPEND(country)
      modify business object /TRDEMOFIN/COUNTRY
        create /TRDEMOFIN/COUNTRIES fields (COUNTRY_CODE, NAME) from countries
      end
    end
  end

  # Creates a company through the business object /TRDEMOFIN/COMPANY and saves
  # it. Other packages check and adjust new companies through the extension
  # point /TRDEMOFIN/COMPANY_CHECKS, e.g. the connection to OTTO; a company
  # they or the user's authorizations reject raises /TRDEMOFIN/COMPANY_REJECTED.
  public static method CREATE(id: /TRDEMOFIN/COMPANY, name: STRING, country: /TRDEMOFIN/COUNTRY_CODE) returns /TRDEMOFIN/COMPANIES raises /TRDEMOFIN/COMPANY_REJECTED
    var companies: array of new of /TRDEMOFIN/COMPANIES = []
    var company: new of /TRDEMOFIN/COMPANIES
    company.COMPANY_ID = id
    company.NAME = name
    company.COUNTRY = country
    companies.APPEND(company)
    modify business object /TRDEMOFIN/COMPANY
      create /TRDEMOFIN/COMPANIES fields (COMPANY_ID, NAME, COUNTRY) from companies
      result created
    end
    if created.FAILURES is not empty
      rollback business objects
      raise /TRDEMOFIN/COMPANY_REJECTED with id, REASON(created)
    end
    commit business objects result saved
    if saved.FAILURES is not empty
      rollback business objects
      raise /TRDEMOFIN/COMPANY_REJECTED with id, REASON(saved)
    end
    var stored = FIND(id)
    if stored is null
      raise /TRDEMOFIN/COMPANY_REJECTED with id, "not saved"
    end
    return stored
  end

  # The first error message of a result, else the reason of its first
  # failure.
  private static method REASON(result: /TRBASE/ENTITY_RESULT) returns STRING
    for m in result.MESSAGES
      if m.SEVERITY = /TRBASE/MESSAGE_SEVERITY.ERROR
        return m.TEXT
      end
    end
    if result.FAILURES is empty
      return "unknown"
    end
    return "{result.FAILURES[1].REASON}"
  end

  public static method FIND(id: /TRDEMOFIN/COMPANY) returns /TRDEMOFIN/COMPANIES?
    return select single from /TRDEMOFIN/COMPANIES where COMPANY_ID = id
  end

  public static method IN_COUNTRY(country: /TRDEMOFIN/COUNTRY_CODE) returns array of /TRDEMOFIN/COMPANIES
    return select from /TRDEMOFIN/COMPANIES where COUNTRY = country order by NAME
  end

  public static method RENAME(id: /TRDEMOFIN/COMPANY, name: STRING) raises /TRDEMOFIN/UNKNOWN_COMPANY
    var rows: array of /TRDEMOFIN/COMPANIES = []
    var row: /TRDEMOFIN/COMPANIES
    row.COMPANY_ID = id
    row.NAME = name
    rows.APPEND(row)
    modify business object /TRDEMOFIN/COMPANY
      update /TRDEMOFIN/COMPANIES fields (NAME) from rows
      result outcome
    end
    if outcome.FAILURES is not empty
      raise /TRDEMOFIN/UNKNOWN_COMPANY with id
    end
  end

  # Moves a company to another country; the business object and its
  # extensions check the country when the change is saved.
  public static method MOVE(id: /TRDEMOFIN/COMPANY, country: /TRDEMOFIN/COUNTRY_CODE) raises /TRDEMOFIN/COMPANY_REJECTED
    var rows: array of /TRDEMOFIN/COMPANIES = []
    var row: /TRDEMOFIN/COMPANIES
    row.COMPANY_ID = id
    row.COUNTRY = country
    rows.APPEND(row)
    modify business object /TRDEMOFIN/COMPANY
      update /TRDEMOFIN/COMPANIES fields (COUNTRY) from rows
      result outcome
    end
    if outcome.FAILURES is not empty
      rollback business objects
      raise /TRDEMOFIN/COMPANY_REJECTED with id, REASON(outcome)
    end
    commit business objects result saved
    if saved.FAILURES is not empty
      rollback business objects
      raise /TRDEMOFIN/COMPANY_REJECTED with id, REASON(saved)
    end
  end

  # Blocks all active companies of a country and returns their number.
  public static method BLOCK_COUNTRY(country: /TRDEMOFIN/COUNTRY_CODE) returns INT8
    var keys: array of key of /TRDEMOFIN/COMPANIES = []
    for company in select from /TRDEMOFIN/COMPANIES where COUNTRY = country and STATUS = /TRDEMOFIN/COMPANY_STATUS.ACTIVE
      var key: key of /TRDEMOFIN/COMPANIES
      key.COMPANY_ID = company.COMPANY_ID
      keys.APPEND(key)
    end
    var reason: /TRDEMOFIN/BLOCK_REASON
    reason.TEXT = "country {country} blocked"
    modify business object /TRDEMOFIN/COMPANY
      execute /TRDEMOFIN/COMPANIES.BLOCK keys keys parameter reason into blocked
    end
    return blocked.LENGTH()
  end

  # Deletes the closed companies with their contacts and bank accounts.
  public static method REMOVE_CLOSED() returns INT8
    var keys: array of key of /TRDEMOFIN/COMPANIES = []
    for company in select from /TRDEMOFIN/COMPANIES where STATUS = /TRDEMOFIN/COMPANY_STATUS.CLOSED
      var key: key of /TRDEMOFIN/COMPANIES
      key.COMPANY_ID = company.COMPANY_ID
      keys.APPEND(key)
    end
    modify business object /TRDEMOFIN/COMPANY
      delete /TRDEMOFIN/COMPANIES keys keys
      result outcome
    end
    return keys.LENGTH() - outcome.FAILURES.LENGTH()
  end

end
